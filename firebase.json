{
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "!/testweb/**",
          "destination": "/index.html"
        },
        {
          "source": "!/api/**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "testweb",
      "public": "public/testweb/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
