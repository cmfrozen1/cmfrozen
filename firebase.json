{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    },
    {
      "source": "public/testweb",
      "codebase": "testweb",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "server.log",
        "dev.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api",
          "region": "asia-southeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "testweb",
      "public": "public/testweb/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api",
          "region": "asia-southeast1"
        },
        {
          "source": "/health",
          "function": "api",
          "region": "asia-southeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
