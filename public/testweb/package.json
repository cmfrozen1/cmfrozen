{
  "name": "mongodb-crud-simple",
  "version": "1.0.0",
  "description": "Simple CRUD with Node.js and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy": "XDG_CONFIG_HOME=/tmp/firebase-config NO_UPDATE_NOTIFIER=1 firebase deploy",
    "deploy:functions": "XDG_CONFIG_HOME=/tmp/firebase-config NO_UPDATE_NOTIFIER=1 firebase deploy --only functions",
    "deploy:hosting": "XDG_CONFIG_HOME=/tmp/firebase-config NO_UPDATE_NOTIFIER=1 firebase deploy --only hosting"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.19.1",
    "nodemon": "^3.0.0"
  }
}
