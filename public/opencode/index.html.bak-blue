    (function(){
      var btn=document.getElementById('hamburger'),menu=document.getElementById('mobileMenu'),closeBtn=document.getElementById('mobileClose');
      function openMenu(){menu.hidden=false;requestAnimationFrame(function(){menu.classList.add('active')});btn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';closeBtn&&closeBtn.focus()}
      function closeMenu(){menu.classList.remove('active');btn.setAttribute('aria-expanded','false');document.body.style.overflow='';setTimeout(function(){menu.hidden=true},300);btn.focus()}
      btn.addEventListener('click',function(){menu.classList.contains('active')?closeMenu():openMenu()});
      closeBtn&&closeBtn.addEventListener('click',closeMenu);
      menu.addEventListener('click',function(e){if(e.target===menu)closeMenu()});
      document.addEventListener('keydown',function(e){if(e.key==='Escape'&&menu.classList.contains('active'))closeMenu()});
      document.querySelectorAll('.mobile-menu-links a, .mobile-menu-cta').forEach(function(a){a.addEventListener('click',closeMenu)});
    })();
    document.querySelectorAll('a[href^="#"]').forEach(function(a){
      a.addEventListener('click',function(e){
        var href=this.getAttribute('href');
        if(href.length>1){var t=document.querySelector(href);if(t){e.preventDefault();var top=t.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:top,behavior:'smooth'});history.pushState(null,'',href)}}
      });
    });
    (function(){
      var sections=document.querySelectorAll('section[id]');var navLinks=document.querySelectorAll('.header-links a[href^="#"]');if(!sections.length)return;
      var obs=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){var id=en.target.id;navLinks.forEach(function(l){l.classList.toggle('active',l.getAttribute('href')==='#'+id); if(l.getAttribute('href')==='#'+id) l.setAttribute('aria-current','true'); else l.removeAttribute('aria-current')})}
        });
      },{rootMargin:'-40% 0px -55% 0px',threshold:0});
      sections.forEach(function(s){obs.observe(s)});
    })();
    (function(){var inner=document.querySelector('.header-inner');if(!inner)return;window.addEventListener('scroll',function(){inner.classList.toggle('is-scrolled',window.scrollY>10)},{passive:true})})();
    (function(){
      var els=document.querySelectorAll('.reveal, .model-card, .about-card, .timeline-item, .contact-item, .stock-card');
      els.forEach(function(el,i){if(!el.classList.contains('reveal'))el.classList.add('reveal');el.style.transitionDelay=(i%4*70)+'ms'});
      var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
      els.forEach(function(el){io.observe(el)});
    })();
    (function(){
      var btn=document.getElementById('themeToggle'),icon=document.getElementById('themeIcon');if(!btn)return;
      var KEY='cmf-theme';
      function apply(t){if(t==='dark')document.documentElement.setAttribute('data-theme','dark');else document.documentElement.removeAttribute('data-theme');if(icon)icon.className=t==='dark'?'fa-solid fa-sun':'fa-solid fa-moon'}
      var saved=localStorage.getItem(KEY);var prefersDark=window.matchMedia('(prefers-color-scheme: dark)').matches;var cur=saved||(prefersDark?'dark':'light');apply(cur);
      btn.addEventListener('click',function(){cur=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';localStorage.setItem(KEY,cur);apply(cur)});
    })();
    // ===== Animated Favicon — เคลื่อนไหวชัดเจน =====
    (function(){
      var link=document.getElementById('favicon');if(!link)return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var canvas=document.createElement('canvas');canvas.width=32;canvas.height=32;var ctx=canvas.getContext('2d');if(!ctx)return;
      if(!ctx.roundRect){ctx.roundRect=function(x,y,w,h,r){this.beginPath();this.moveTo(x+r,y);this.arcTo(x+w,y,x+w,y+h,r);this.arcTo(x+w,y+h,x,y+h,r);this.arcTo(x,y+h,x,y,r);this.arcTo(x,y,x+w,y,r);this.closePath();return this};}
      var frame=0,rafId=null,last=0,interval=65;
      function setFavicon(url){link.href=url;link.type='image/png';if(frame%30===0){var clone=link.cloneNode(true);clone.href=url;link.remove();document.head.appendChild(clone);link=clone;link.id='favicon'}}
      function draw(){
        var t=frame;ctx.clearRect(0,0,32,32);
        var hue=(220+t*1.8)%360,hue2=(hue+38)%360;
        var g=ctx.createLinearGradient(0,0,32,32);g.addColorStop(0,'hsl('+hue+',100%,58%)');g.addColorStop(1,'hsl('+hue2+',100%,62%)');
        ctx.fillStyle=g;var pulse=1+Math.sin(t*.18)*.06,size=28*pulse,off=(32-size)/2;
        ctx.beginPath();try{ctx.roundRect(off,off,size,size,8)}catch(e){ctx.rect(off,off,size,size)}ctx.fill();
        ctx.fillStyle='rgba(255,255,255,.22)';ctx.beginPath();try{ctx.roundRect(off,off,size,size*.48,8)}catch(e){ctx.rect(off,off,size,size*.45)}ctx.fill();
        ctx.fillStyle='#fff';ctx.font='900 13px \"Noto Sans Thai\",sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.shadowColor='rgba(0,0,0,.25)';ctx.shadowBlur=4;ctx.fillText('CM',16,16.5+Math.sin(t*.22)*.9);ctx.shadowColor='transparent';
        var ang=t*.22,r=11,sx=16+Math.cos(ang)*r,sy=16+Math.sin(ang)*r;
        ctx.save();ctx.translate(sx,sy);ctx.rotate(ang*2);ctx.font='9px serif';ctx.fillText('❄',0,0);ctx.restore();
        ctx.beginPath();ctx.arc(sx,sy,5,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,.18)';ctx.fill();
        try{setFavicon(canvas.toDataURL('image/png'))}catch(e){}
        frame=(frame+1)%1000;
      }
      function loop(now){rafId=requestAnimationFrame(loop);if(now-last<interval)return;last=now;draw()}
      function start(){if(rafId)return;last=performance.now();rafId=requestAnimationFrame(loop)}
      function stop(){if(rafId)cancelAnimationFrame(rafId);rafId=null}
      document.addEventListener('visibilitychange',function(){if(document.hidden)stop();else start()});
      try{draw();start()}catch(e){var emojis=['🧊','❄️','💠'],ei=0;setInterval(function(){link.href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>"+emojis[ei%emojis.length]+"</text></svg>";ei++},600)}
      window.__faviconAnim={start:start,stop:stop}
    })();
  </script>
</body>
</html>
